                "admin",
                "{{query_id}}",
                "respond"
              ]
            },
            "description": "Admin/HR respond to query with images"
          },
          "response": []
        },
        {
          "name": "View Query Message Image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hr-queries/{{query_id}}/images/{{image_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hr-queries",
                "{{query_id}}",
                "images",
                "{{image_id}}"
              ]
            },
            "description": "View image inline in browser"
          },
          "response": []
        },
        {
          "name": "Download Query Message Image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hr-queries/{{query_id}}/images/{{image_id}}?download=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hr-queries",
                "{{query_id}}",
                "images",
                "{{image_id}}"
              ],
              "query": [
                {
                  "key": "download",
                  "value": "true"
                }
              ]
            },
            "description": "Download image as file"
          },
          "response": []
        }
      ]
    }
  ]
}
